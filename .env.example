# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://safesite:safesite_pass@localhost:5432/safesite_db

# ─── YOLO / Computer Vision ──────────────────────────────────────────────────
YOLO_WEIGHTS_PATH=backend/weights/best.pt
# Frame skip: process every Nth frame (1 = every frame, 3 = every 3rd frame)
FRAME_SKIP=3

# ─── File Storage Paths ───────────────────────────────────────────────────────
UPLOAD_DIR=backend/uploads
OUTPUT_DIR=backend/outputs
VIOLATION_FRAMES_DIR=backend/violation_frames
REPORTS_DIR=backend/reports

# ─── LLM / AI Layer ───────────────────────────────────────────────────────────
# Supported: openai | groq | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# ─── Vector Database ──────────────────────────────────────────────────────────
VECTOR_DB_PATH=chroma_db
VECTOR_COLLECTION_NAME=safety_policies

# ─── Alert Channels ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Violation Engine ─────────────────────────────────────────────────────────
# Seconds between repeated violations for the same worker
VIOLATION_COOLDOWN_SECONDS=5
